# Copia este archivo a .env y completa lo que necesites. NUNCA subas .env a git.

# Proveedor del LLM: "anthropic", "openai" u "ollama"
LLM_PROVIDER=anthropic

# Solo necesitas la clave del proveedor que uses. Ollama no necesita clave.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: modelo del supervisor y de los especialistas (si se omiten se usan los predeterminados)
# SUPERVISOR_MODEL=claude-sonnet-5-5
# WORKER_MODEL=claude-haiku-5-5

# Opcional: dirección del servidor de Ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Notebook de demostración: "guionizado" (sin LLM) o "real" (usa el proveedor de arriba)
DEMO_MODO=guionizado
